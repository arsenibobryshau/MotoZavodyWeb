@model MotoZavodyWeb.Models.AuditLogViewModel

@{
    ViewData["Title"] = "Auditní logy a Historie";
}

<div class="container py-4">
    <h1 class="mb-4 fw-bold">Auditní logy a Historie</h1>

    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Zde vidíš historii změn v kritických tabulkách (Audit Trail).
    </div>

    <div class="card shadow-sm mb-5">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-person-lines-fill"></i> Historie změn závodníků (ZAVODNICI_HIST)</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover table-bordered">
                    <thead class="table-light text-dark">
                        <tr>
                            <th>ID Hist</th>
                            <th>Datum</th>
                            <th>Operace</th>
                            <th>Změnil (User)</th>
                            <th>ID Závodníka</th>
                            <th>Jméno a Příjmení</th>
                            <th>Věk</th>
                            <th>Pohlaví</th>
                            <th>Zkušenost</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.LogyZavodniku != null)
                        {
                            @foreach (var log in Model.LogyZavodniku)
                            {
                                <tr>
                                    <td><small class="text-muted">#@log.IdHist</small></td>
                                    <td>@log.DatumOperace.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        @if (log.Operace == "INSERT")
                                        {
                                            <span class="badge bg-success">NOVÝ</span>
                                        }
                                        else if (log.Operace == "UPDATE")
                                        {

                                            <span class="badge bg-warning text-dark">ZMĚNA</span>
                                        }
                                        else if (log.Operace == "DELETE")
                                        {

                                            <span class="badge bg-danger">SMAZÁNO</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-secondary">@log.Operace</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@log.Uzivatel</span></td>
                                    <td>@log.IdZavodnik</td>
                                    <td class="fw-bold">@log.Jmeno @log.Prijmeni</td>
                                    <td>@(log.Vek?.ToString() ?? "-")</td>
                                    <td>@log.Pohlavi</td>
                                    <td>@log.UrovenZkusenosti</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="9" class="text-center text-muted">Žádné záznamy v historii závodníků.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0"><i class="bi bi-currency-exchange"></i> Auditní log plateb (TR_PLATBY_LOG)</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-striped table-bordered">
                    <thead class="table-light text-dark">
                        <tr>
                            <th>ID</th>
                            <th>Datum</th>
                            <th>Uživatel (DB)</th>
                            <th>Operace</th>
                            <th>ID Platby</th>
                            <th>Částka</th>
                            <th>Stará částka</th>
                            <th>Nová částka</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.LogyPlateb != null)
                        {
                            @foreach (var log in Model.LogyPlateb)
                            {
                                <tr>
                                    <td>@log.IdLog</td>
                                    <td>@log.Datum.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                    <td>@log.Uzivatel</td>
                                    <td>
                                        @if (log.Operace == "INSERT")
                                        {
                                            <span class="badge bg-success">NOVÝ</span>
                                        }
                                        else if (log.Operace == "UPDATE")
                                        {

                                            <span class="badge bg-warning text-dark">ZMĚNA</span>
                                        }
                                        else if (log.Operace == "DELETE")
                                        {

                                            <span class="badge bg-danger">SMAZÁNO</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-secondary">@log.Operace</span>
                                        }
                                    </td>
                                    <td>@log.IdPlatby</td>
                                    <td class="text-end fw-bold">@log.Castka?.ToString("F2") Kč</td>
                                    <td class="text-end text-muted">@(log.StaraCastka?.ToString("F2") ?? "-")</td>
                                    <td class="text-end fw-bold">@(log.NovaCastka?.ToString("F2") ?? "-")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Zpět na Dashboard</a>
    </div>
</div>