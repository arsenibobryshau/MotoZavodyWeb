@model IEnumerable<MotoZavodyWeb.Models.SystemovyObjekt>

@{
    ViewData["Title"] = "Systémový katalog";
}

<h2 class="mb-4">Databázové objekty (System Catalog)</h2>

<p class="text-muted">
    Výpis objektů ze systémového pohledu <code>USER_OBJECTS</code>.
</p>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Typ objektu</th>
            <th>Název</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var obj in Model)
        {
            <tr>
                <td>
                    <span class="badge bg-info text-dark">@obj.Typ</span>
                </td>
                <td class="fw-bold">@obj.Nazev</td>
                <td>
                    @if (obj.Status == "VALID")
                    {
                        <span class="text-success"><i class="bi bi-check-circle"></i> Valid</span>
                    }
                    else
                    {
                        <span class="text-danger">@obj.Status</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Zpět na Dashboard</a>
</div>