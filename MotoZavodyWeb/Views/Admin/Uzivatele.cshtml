@model IEnumerable<MotoZavodyWeb.Models.Uzivatel>

@{
    ViewData["Title"] = "Správa uživatelů";
}

<h2>Správa uživatelů</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Jméno</th>
            <th>E-mail</th>
            <th>Role</th>
            <th>Závodník</th>
            <th>Poslední přihlášení</th>
            <th>Akce</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Jmeno @u.Prijmeni</td>
                <td>@u.Email</td>
                <td>
                    <span class="badge @(u.Role == "ADMIN" ? "bg-danger" : "bg-secondary")">
                        @u.Role
                    </span>
                </td>
                <td>
                    @if (u.Zavodnik != null)
                    {
                        <span class="text-success fw-bold">Ano</span>
                    }
                    else
                    {
                        <span class="text-muted">Ne</span>
                    }
                </td>
                <td>
                    @if (u.DatumPoslednihoPrihlaseni.HasValue)
                    {
                        @u.DatumPoslednihoPrihlaseni.Value.ToString("dd.MM.yyyy HH:mm")
                    }
                    else
                    {
                        @:-
                    }
                </td>
                <td>
                    <div class="btn-group" role="group">
                        <form asp-action="ZmenRoli" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idUzivatel" value="@u.IdUzivatel" />
                            <input type="hidden" name="role" value="@(u.Role == "USER" ? "ADMIN" : "USER")" />
                            <button type="submit" class="btn btn-sm btn-outline-primary" title="Přepnout roli">
                                <i class="bi bi-person-badge"></i> @(u.Role == "USER" ? "Nastavit Admin" : "Nastavit User")
                            </button>
                        </form>

                        <form asp-action="ResetHesla" method="post" class="d-inline ms-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idUzivatel" value="@u.IdUzivatel" />
                            <button type="submit" class="btn btn-sm btn-outline-warning" title="Resetovat heslo na 123456">
                                <i class="bi bi-key"></i>
                            </button>
                        </form>

                        <form asp-action="Emulovat" method="post" class="d-inline ms-1"
                              onsubmit="return confirm('Opravdu se chcete přihlásit jako tento uživatel?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idUzivatel" value="@u.IdUzivatel" />
                            <button type="submit" class="btn btn-sm btn-outline-dark" title="Přihlásit se jako tento uživatel">
                                <i class="bi bi-eye"></i> Emulovat
                            </button>
                        </form>

                        <form asp-action="SmazUzivatele" method="post" class="d-inline ms-1"
                              onsubmit="return confirm('Opravdu smazat?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idUzivatel" value="@u.IdUzivatel" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Smazat uživatele">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>