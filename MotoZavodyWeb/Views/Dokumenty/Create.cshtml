@model MotoZavodyWeb.Models.DokumentCreateViewModel

@{
    ViewData["Title"] = "Nahrát dokument";
}

<h2>Nahrát dokument závodníka</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="IdZavodnik" class="control-label"></label>
        <select asp-for="IdZavodnik" asp-items="Model.Zavodnici" class="form-control">
            <option value="">-- vyberte závodníka --</option>
        </select>
        <span asp-validation-for="IdZavodnik" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Soubor" class="control-label"></label>
        <input asp-for="Soubor" type="file" class="form-control" />
        <span asp-validation-for="Soubor" class="text-danger"></span>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Nahrát</button>
    <a asp-action="Index" class="btn btn-secondary">Zpět na seznam</a>
</form>
