@model IEnumerable<MotoZavodyWeb.Models.DokumentZavodnika>

@{
    ViewData["Title"] = "Dokumenty závodníků";
    var role = Context.Session.GetString("UserRole");
}

<h2>Dokumenty závodníků</h2>

@if (role == "ADMIN")
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Nahrát nový dokument</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            @if (role == "ADMIN")
            {
                <th>Závodník</th>
                <th>Veřejné?</th>
            }
            <th>Název souboru</th>
            <th>Typ souboru</th>
            <th>Datum nahrání</th>
            <th>Vytvořil</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                @if (role == "ADMIN")
                {
                    <td>@($"{d.Zavodnik?.Jmeno} {d.Zavodnik?.Prijmeni}")</td>

                    <td>
                        @(d.ViditelneVsem ? "🔓" : "🔒")
                    </td>
                }

                <td>@d.NazevSouboru.@d.PriponaSouboru</td>
                <td>@d.TypSouboru</td>
                <td>@d.DatumNahrani?.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@d.UzivatelVytvoril</td>

                <td>
                    <a asp-action="Download" asp-route-id="@d.IdDokument"
                       class="btn btn-sm btn-outline-secondary">Stáhnout</a>

                    @if (role == "ADMIN")
                    {
                        <form asp-action="Delete" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@d.IdDokument" />
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Opravdu chcete smazat tento dokument?');">
                                Smazat
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
