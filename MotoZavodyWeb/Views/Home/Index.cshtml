@model IEnumerable<MotoZavodyWeb.Models.Zavod>

    @{
    ViewData["Title"] = "Nadcházející závody";
    }

    <h2>@ViewData["Title"]</h2>

    <table class="table">
        <thead>
            <tr>
                <th>Název</th>
                <th>Datum</th>
                <th>Startovné</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var z in Model)
            {
            <tr>
                <td>@z.Nazev</td>
                <td>@z.Datum?.ToShortDateString()</td>
                <td>@z.Startovne</td>
                <td>
                    <a asp-controller="Zavody" asp-action="Details" asp-route-id="@z.IdZavod">
                        Detail
                    </a>
                </td>
            </tr>
            }
        </tbody>
    </table>
