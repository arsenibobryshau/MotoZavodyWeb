@model IEnumerable<MotoZavodyWeb.Models.UcastDetailView>

@{
    ViewData["Title"] = "Účasti";
}

<h2>Účasti závodníků</h2>

<p>
    @if (Context.Session.GetString("UserRole") == "ADMIN")
    {
        <a asp-action="Create" class="btn btn-primary">Přihlásit závodníka na závod</a>
    }
    else
    {
        <a asp-action="PrihlasitSe" class="btn btn-success">Přihlásit se na závod</a>
    }
</p>

<table class="table">
    <thead>
        <tr>
            <th>Závodník</th>
            <th>Závod</th>
            <th>Datum závodu</th>
            <th>Částka</th>
            <th>Typ platby</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Jmeno @u.Prijmeni</td>
                <td>@u.NazevZavodu</td>
                <td>@u.DatumZavodu.ToShortDateString()</td>
                <td>@u.Castka</td>
                <td>
                    @if (u.TypPlatby == "H")
                    {
                        @:Hotově
                    }
                    else if (u.TypPlatby == "K")
                    {
                        @:Kartou
                    }
                    else
                    {
                        @u.TypPlatby
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
