@{
    ViewData["Title"] = "Nahrát profilovou fotku";
}

<h2>Nahrát profilovou fotku</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="NahratFoto" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Vyberte obrázek:</label>
        <input type="file" name="foto" class="form-control" accept="image/*" required />
    </div>

    <button class="btn btn-primary">Nahrát</button>
    <a asp-action="Profil" class="btn btn-secondary">Zpět</a>
</form>
