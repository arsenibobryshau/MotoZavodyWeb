<h2>Registrace</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form method="post">

    <div class="mb-3">
        <label class="form-label">Jméno</label>
        <input class="form-control" name="jmeno" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Příjmení</label>
        <input class="form-control" name="prijmeni" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input class="form-control" type="email" name="email" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Heslo</label>
        <input class="form-control" type="password" name="heslo" required />
    </div>

    <button class="btn btn-primary">Registrovat</button>
</form>

<p class="mt-3">
    Už máte účet?
    <a asp-controller="Uzivatele" asp-action="Login">Přihlaste se zde.</a>
</p>
