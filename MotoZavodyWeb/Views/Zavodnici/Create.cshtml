@model MotoZavodyWeb.Models.ZavodnikCreateViewModel

@{
    ViewData["Title"] = "Registrace závodníka";
}

<h2>Registrace závodníka</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Jmeno" class="control-label"></label>
        <input asp-for="Jmeno" class="form-control" />
        <span asp-validation-for="Jmeno" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Prijmeni" class="control-label"></label>
        <input asp-for="Prijmeni" class="form-control" />
        <span asp-validation-for="Prijmeni" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Vek" class="control-label"></label>
        <input asp-for="Vek" class="form-control" />
        <span asp-validation-for="Vek" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Pohlavi" class="control-label"></label>
        <select asp-for="Pohlavi" class="form-control">
            <option value="M">Muž</option>
            <option value="Z">Žena</option>
        </select>
        <span asp-validation-for="Pohlavi" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="UrovenZkusenosti" class="control-label"></label>
        <select asp-for="UrovenZkusenosti" class="form-control">
            <option value="D">D - Začátečník</option>
            <option value="C">C - Mírně pokročilý</option>
            <option value="B">B - Pokročilý</option>
            <option value="A">A - Profesionál</option>
        </select>
        <span asp-validation-for="UrovenZkusenosti" class="text-danger"></span>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Registrovat</button>
    <a asp-action="Index" class="btn btn-secondary">Zpět na seznam</a>
</form>

