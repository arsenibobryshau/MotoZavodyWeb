@model IEnumerable<MotoZavodyWeb.Models.Zavodnik>

@{
    var role = ViewBag.Role as string;
    bool maProfil = ViewBag.MaProfil ?? false;
    bool isAdmin = role == "ADMIN";
}

<h2>Závodníci</h2>

@if (role == "ADMIN")
{
    <a asp-action="Create" class="btn btn-primary mb-3">Registrovat nového závodníka</a>
}
else if (role == "USER" && !maProfil)
{
    <a asp-action="Create" class="btn btn-success mb-3">Vytvořit můj závodnický profil</a>
}

<table class="table table-hover">
    <thead>
        <tr>
            <th>Jméno</th>
            <th>Příjmení</th>
            <th>Věk</th>
            <th>Pohlaví</th>
            <th>Úroveň</th>
            @if (isAdmin)
            {
                <th>Akce</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var z in Model)
        {
            <tr>
                <td>@z.Jmeno</td>
                <td>
                    @if (isAdmin)
                    {
                        @z.Prijmeni
                    }
                    else
                    {
                        if (!string.IsNullOrEmpty(z.Prijmeni) && z.Prijmeni.Length > 1)
                        {
                            @($"{z.Prijmeni.Substring(0, 1)}****")
                        }
                        else
                        {
                            @("****")
                        }
                    }
                </td>
                <td>@z.Vek</td>
                <td>@z.Pohlavi</td>
                <td>@z.UrovenZkusenosti</td>

                @if (isAdmin)
                {
                    <td>
                        <div class="btn-group">
                            <a asp-action="Edit"
                               asp-route-id="@z.IdZavodnik"
                               class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Opravdu smazat závodníka @z.Jmeno @z.Prijmeni?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@z.IdZavodnik" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                }

            </tr>
        }
    </tbody>
</table>