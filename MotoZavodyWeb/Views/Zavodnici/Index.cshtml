@model IEnumerable<MotoZavodyWeb.Models.Zavodnik>

@{
    var role = ViewBag.Role as string;
    bool maProfil = ViewBag.MaProfil ?? false;
}

<h2>Závodníci</h2>

@if (role == "ADMIN")
{
    <a asp-action="Create" class="btn btn-primary mb-3">Registrovat nového závodníka</a>
}
else if (role == "USER" && !maProfil)
{
    <a asp-action="Create" class="btn btn-success mb-3">Vytvořit můj závodnický profil</a>
}

</p>

<table class="table">
    <thead>
        <tr>
            <th>Jméno</th>
            <th>Příjmení</th>
            <th>Věk</th>
            <th>Pohlaví</th>
            <th>Úroveň</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var z in Model)
        {
            <tr>
                <td>@z.Jmeno</td>
                <td>@z.Prijmeni</td>
                <td>@z.Vek</td>
                <td>@z.Pohlavi</td>
                <td>@z.UrovenZkusenosti</td>
            </tr>
        }
    </tbody>
</table>
