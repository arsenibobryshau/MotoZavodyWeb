@model MotoZavodyWeb.Models.Zavod

<h2>Upravit závod</h2>

<div class="card p-4 shadow-sm">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="IdZavod" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nazev" class="form-label"></label>
            <input asp-for="Nazev" class="form-control" />
            <span asp-validation-for="Nazev" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Datum" class="form-label"></label>
            <input asp-for="Datum" type="date" class="form-control" />
            <span asp-validation-for="Datum" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Startovne" class="form-label"></label>
            <input asp-for="Startovne" class="form-control" step="0.01" type="number" />
            <span asp-validation-for="Startovne" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IdTypZavodu" class="form-label"></label>
            <select asp-for="IdTypZavodu" class="form-control"
                    asp-items="@(new SelectList(ViewBag.Typy, "IdTypZavodu", "Nazev"))"></select>
        </div>

        <div class="mb-3">
            <label asp-for="IdMisto" class="form-label"></label>
            <select asp-for="IdMisto" class="form-control"
                    asp-items="@(new SelectList(ViewBag.Mista, "IdMisto", "Nazev"))"></select>
        </div>

        <div class="mb-3">
            <label asp-for="IdHodnoceni" class="form-label"></label>
            <select asp-for="IdHodnoceni" class="form-control"
                    asp-items="@(new SelectList(ViewBag.Hodnoceni, "IdHodnoceni", "Metoda"))"></select>
        </div>

        <button type="submit" class="btn btn-warning">Uložit změny</button>
        <a asp-action="Index" class="btn btn-secondary">Zpět</a>
    </form>
</div>
