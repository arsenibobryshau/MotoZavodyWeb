@model IEnumerable<MotoZavodyWeb.Models.Zavod>

@{
    ViewData["Title"] = "Všechny závody";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Zatím nejsou k dispozici žádné závody.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Název</th>
                <th>Datum</th>
                <th>Typ</th>
                <th>Místo</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var z in Model)
            {
                <tr>
                    <td>@z.Nazev</td>
                    <td>@z.Datum?.ToShortDateString()</td>
                    <td>@z.TypZavodu?.Nazev</td>
                    <td>@z.Misto?.Nazev</td>
                    <td>
                        <a class="btn btn-sm btn-primary"
                           asp-action="Details"
                           asp-route-id="@z.IdZavod">
                            Detail
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
