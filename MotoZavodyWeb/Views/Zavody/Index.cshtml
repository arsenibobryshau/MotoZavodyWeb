@model IEnumerable<MotoZavodyWeb.Models.ZavodDetailView>
@{
    ViewData["Title"] = "Závody";
    var role = Context.Session.GetString("UserRole");
}

<h2>Závody</h2>

@if (role == "ADMIN")
{
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-plus-lg"></i> Přidat závod
    </a>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Název závodu</th>
            <th>Datum</th>
            <th>Místo</th>
            <th>Startovné</th>
            <th>Typ závodu</th>
            <th>Hodnocení</th>
            @if (role == "ADMIN")
            {
                <th>Akce</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var z in Model)
        {
            <tr>
                <td>
                    <a asp-action="Details" asp-route-id="@z.IdZavod" class="fw-bold text-decoration-none">
                        @z.NazevZavodu
                    </a>
                </td>
                <td>@z.Datum.ToShortDateString()</td>
                <td>@z.Misto</td>
                <td>@z.Startovne Kč</td>
                <td><span class="badge bg-info text-dark">@z.TypZavodu</span></td>
                <td>@z.MetodaHodnoceni</td>

                @if (role == "ADMIN")
                {
                    <td>
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@z.IdZavod" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Opravdu smazat závod @z.NazevZavodu?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@z.IdZavod" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>