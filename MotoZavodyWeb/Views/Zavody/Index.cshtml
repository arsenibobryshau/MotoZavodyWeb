@model IEnumerable<MotoZavodyWeb.Models.ZavodDetailView>
@{
    ViewData["Title"] = "Závody";
    var role = Context.Session.GetString("UserRole");
}

<h2>Závody</h2>

@if (role == "ADMIN")
{
    <a asp-action="Create" class="btn btn-success mb-3">Přidat závod</a>
}

<table class="table">
    <thead>
        <tr>
            <th>Název závodu</th>
            <th>Datum</th>
            <th>Místo</th>
            <th>Startovné</th>
            <th>Typ závodu</th>
            <th>Hodnocení</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var z in Model)
        {
            <tr>
                <td>@z.NazevZavodu</td>
                <td>@z.Datum.ToShortDateString()</td>
                <td>@z.Misto, @z.Mesto (@z.Ulice @z.Cp)</td>
                <td>@z.Startovne</td>
                <td>@z.TypZavodu</td>
                <td>@z.MetodaHodnoceni</td>
            </tr>
        }
    </tbody>
</table>
