@model MotoZavodyWeb.Models.Ucast

@{
    ViewData["Title"] = "Registrace na závod";
}

<h2 class="mb-4">Registrace na závod @Model.IdZavod</h2>

<div class="card p-4 shadow-sm">

    <form asp-action="Register" method="post">
        <input type="hidden" asp-for="IdZavod" />

        <div class="mb-3">
            <label asp-for="IdZavodnik" class="form-label">ID závodníka</label>
            <input asp-for="IdZavodnik" class="form-control" />
            <span asp-validation-for="IdZavodnik" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Registrovat</button>
    </form>

</div>
