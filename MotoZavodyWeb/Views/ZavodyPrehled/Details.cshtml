@model MotoZavodyWeb.Models.Zavod

@{
    ViewData["Title"] = "Detail závodu";
    var role = Context.Session.GetString("UserRole");
}

<h2 class="mb-4">@Model.Nazev</h2>

<div class="card p-4 shadow-sm">

    <dl class="row">
        <dt class="col-sm-3">Datum</dt>
        <dd class="col-sm-9">@Model.Datum?.ToShortDateString()</dd>

        <dt class="col-sm-3">Místo</dt>
        <dd class="col-sm-9">@Model.Misto?.Nazev</dd>

        <dt class="col-sm-3">Typ</dt>
        <dd class="col-sm-9">@Model.TypZavodu?.Nazev</dd>

        <dt class="col-sm-3">Startovné</dt>
        <dd class="col-sm-9">@Model.Startovne Kč</dd>

        <dt class="col-sm-3">Hodnocení</dt>
        <dd class="col-sm-9">@Model.Hodnoceni?.Metoda</dd>

        @if (role == "ADMIN")
        {
            <dt class="col-sm-3 text-success">Aktuální tržba (Funkce)</dt>
            <dd class="col-sm-9 text-success fw-bold">@ViewBag.Trzba Kč</dd>
        }
    </dl>

    @{
        var isLogged = Context.Session.GetInt32("UserId") != null;
    }

    <div class="mt-3">
        @if (isLogged)
        {
            <a asp-controller="Ucasti"
               asp-action="PrihlasitSe"
               asp-route-id="@Model.IdZavod"
               class="btn btn-primary">
                Registrovat se
            </a>
        }
        else
        {
            <a asp-controller="Uzivatele"
               asp-action="Registrace"
               class="btn btn-primary">
                Registrovat se
            </a>
        }

        <a asp-action="Index" class="btn btn-secondary ms-2">Zpět na seznam</a>
    </div>

</div>
