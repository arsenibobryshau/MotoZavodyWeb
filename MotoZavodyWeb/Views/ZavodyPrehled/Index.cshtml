@model IEnumerable<MotoZavodyWeb.Models.ZavodPrehledItem>

@{
    ViewData["Title"] = "Přehled závodů";
    var role = Context.Session.GetString("UserRole");
    var isLogged = Context.Session.GetInt32("UserId") != null;
}

<h2 class="mb-4">Přehled závodů</h2>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get">
            <div class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label class="form-label">Rok</label>
                    <select name="rok" class="form-select">
                        <option value="">Všechny roky</option>
                        @foreach (var y in ViewBag.Roky)
                        {
                            <option value="@y" selected="@(Context.Request.Query["rok"] == y.ToString())">
                                @y
                            </option>
                        }
                    </select>

                </div>

                <div class="col-md-3">
                    <label class="form-label">Typ závodu</label>
                    <select name="typ" class="form-select">
                        <option value="">Všechny typy závodu</option>
                        @foreach (var t in ViewBag.Typy)
                        {
                            <option value="@t.IdTypZavodu"
                                    selected="@(Context.Request.Query["typ"] == t.IdTypZavodu.ToString())">
                                @t.Nazev
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Hodnocení</label>
                    <select name="hodnoceni" class="form-select">
                        <option value="">Všechna hodnocení</option>
                        @foreach (var h in ViewBag.Hodnoceni)
                        {
                            <option value="@h.IdHodnoceni"
                                    selected="@(Context.Request.Query["hodnoceni"] == h.IdHodnoceni.ToString())">
                                @h.Metoda
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Řazení ceny</label>
                    <select name="cena" class="form-select">
                        <option value="">Bez řazení</option>
                        <option value="asc" selected="@(Context.Request.Query["cena"] == "asc")">
                            Cena – nejlevnější
                        </option>
                        <option value="desc" selected="@(Context.Request.Query["cena"] == "desc")">
                            Cena – nejdražší
                        </option>
                    </select>
                </div>

                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-success px-4 mt-2">
                        Filtrovat
                    </button>
                </div>

            </div>
        </form>
    </div>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Název</th>
            <th>Rok</th>
            <th>Typ závodu</th>
            <th>Hodnocení</th>
            <th class="text-end">Startovné</th>

            @if (isLogged)
            {
                <th class="text-center">Akce</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var z in Model)
        {
            <tr>
                <td>
                    <span class="fw-bold text-decoration-none">
                        @z.Nazev
                    </span>
                </td>
                <td>@z.Rok</td>
                <td><span class="badge bg-info text-dark">@z.TypZavodu</span></td>
                <td>@z.Hodnoceni</td>
                <td class="text-end">@z.Startovne Kč</td>

                @if (isLogged)
                {
                    <td class="text-center">
                        @if (role == "ADMIN")
                        {
                            <a asp-controller="Ucasti"
                               asp-action="PrihlasitSe"
                               asp-route-id="@z.IdZavod"
                               class="btn btn-sm btn-primary">
                                Přihlásit závodníka
                            </a>
                        }
                        else if (role == "USER")
                        {
                            <a asp-controller="Ucasti"
                               asp-action="PrihlasitSe"
                               asp-route-id="@z.IdZavod"
                               class="btn btn-sm btn-primary">
                                Registrovat se
                            </a>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

